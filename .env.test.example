# .env.test - Test environment configuration
# Copy this to .env.test and fill in your Cloudflare credentials to test against real D1/R2
# If this file doesn't exist or credentials are missing, tests use fast in-memory SQLite

# Cloudflare Account (required for D1/R2 testing)
CLOUDFLARE_TEST_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_TEST_API_TOKEN=your_api_token_here

# R2 Storage (required for storage testing)
CLOUDFLARE_TEST_R2_ACCESS_KEY_ID=your_r2_access_key_here
CLOUDFLARE_TEST_R2_SECRET_ACCESS_KEY=your_r2_secret_key_here

# Notes:
# - Tests will create temporary D1 databases and R2 buckets with unique names
# - Resources are automatically cleaned up after tests complete
# - Without these credentials, tests run against in-memory SQLite (fast, isolated)
