# Cloudflare D1/R2 Integration Test Credentials
# Copy this to .env.test and fill in your Cloudflare test credentials
# Get credentials from: https://dash.cloudflare.com

# Cloudflare Account ID (found in dashboard)
CLOUDFLARE_TEST_ACCOUNT_ID=your-cloudflare-account-id

# API Token with D1:Edit and R2:Edit permissions
# Create at: Dashboard → Profile → API Tokens
CLOUDFLARE_TEST_API_TOKEN=your-cloudflare-api-token

# R2 Access Keys
# Create at: Dashboard → R2 → Manage R2 API Tokens
CLOUDFLARE_TEST_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_TEST_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
