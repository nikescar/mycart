# Local Development Configuration
DB_TYPE=sqlite
DB_PATH=./lc_base/mycart.db
STORAGE_TYPE=filesystem
STORAGE_BASE_PATH=./lc_base/uploads

# Cloudflare Production Configuration (optional)
# Only needed when deploying to Cloudflare Workers
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Runtime Detection (optional override)
RUNTIME=  # Leave empty for auto-detect, or set to "cloudflare"
